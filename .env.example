# --- Обязательные ---
TELEGRAM_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
AI_API_KEY=PASTE_YOUR_PROXYAPI_KEY

# --- ИИ (OpenAI-совместимый эндпоинт) ---
AI_BASE_URL=https://api.proxyapi.ru/openai/v1
AI_MODEL=gpt-4o-mini

# --- Приложение ---
ADMIN_ID=0
OFFER_URL=https://example.com/oferta
DB_PATH=voiceplan.db
FREE_LIMIT=10
PRICE_STARS=199
SUPPORT_HANDLE=@your_support
# Часовой пояс пользователя: локальное время = UTC + offset (МСК = 3)
TZ_OFFSET_HOURS=3

# --- Распознавание речи (Whisper) ---
# tiny | base | small | medium  (small - хороший баланс для русского на CPU)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
